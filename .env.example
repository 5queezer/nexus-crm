# Primary data adapter. The AI operator always requires Prisma/PostgreSQL.
DB_PROVIDER="prisma"

# Required by Prisma and Better Auth.
DATABASE_URL="postgresql://user:password@localhost:5432/nexus"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-random-secret"
BETTER_AUTH_URL="http://localhost:3001"
GOOGLE_CLIENT_ID="your-google-client-id-from-console.cloud.google.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret-from-console.cloud.google.com"
ALLOWED_EMAIL="you@example.com"

# Required before users can save model keys or MCP authorization values.
# Generate with: openssl rand -hex 32
# Exactly 64 hexadecimal characters (32 bytes). Server-side only: never NEXT_PUBLIC_*.
# Back this value up separately; replacing it makes existing encrypted records unreadable.
AGENT_SECRET_ENCRYPTION_KEY="replace-with-64-hex-characters"

# File storage: set GCS_BUCKET for Cloud Storage; omit for local filesystem.
# GCS_BUCKET="your-bucket-name"
# UPLOAD_DIR="./uploads"

# Reactive Resume integration (optional).
# RR_API_URL="https://resume.example.com/api/openapi"
# RR_API_KEY="your-reactive-resume-api-key"
# RR_BASE_RESUME_ID="your-base-resume-id"
