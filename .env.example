# Primary data adapter. The AI operator always requires Prisma/PostgreSQL.
DB_PROVIDER="prisma"

# Required by Prisma and Better Auth.
DATABASE_URL="postgresql://user:password@localhost:5432/nexus"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-random-secret"
BETTER_AUTH_URL="http://localhost:3001"
GOOGLE_CLIENT_ID="your-google-client-id-from-console.cloud.google.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret-from-console.cloud.google.com"
ALLOWED_EMAIL="you@example.com"

# Optional OAuth token-endpoint rate limiting. Set this only to a header that
# your trusted ingress strips from client requests and replaces with the source
# address. Limiting stays disabled when this is unset or the header is absent.
# OAUTH_TRUSTED_IP_HEADER="x-trusted-client-ip"

# Required before users can save model keys or MCP authorization values.
# Generate with: openssl rand -hex 32
# Exactly 64 hexadecimal characters (32 bytes). Server-side only: never NEXT_PUBLIC_*.
# Back this value up separately; replacing it makes existing encrypted records unreadable.
AGENT_SECRET_ENCRYPTION_KEY="replace-with-64-hex-characters"

# File storage: set GCS_BUCKET for Cloud Storage; omit for local filesystem.
# GCS_BUCKET="your-bucket-name"
# UPLOAD_DIR="./uploads"

# Reactive Resume integration (optional).
# RR_API_URL="https://resume.example.com/api/openapi"
# RR_API_KEY="your-reactive-resume-api-key"
# RR_BASE_RESUME_ID="your-base-resume-id"

# ── Hermes Career Ops (optional, server-only) ────────────────────────────────
# Bridges Nexus to an external Hermes "career-ops" agent profile. Disabled by
# default: with HERMES_CAREER_OPS_ENABLED unset (or the URL/key missing) the
# API reports the feature as unavailable and the UI trigger is not rendered.
#
# These are server-only. Never prefix any of them with NEXT_PUBLIC_ — the
# browser talks to Nexus, and only Nexus talks to Hermes.
# HERMES_CAREER_OPS_ENABLED="false"
# Point at the Hermes API server's profile prefix. Prefer loopback or a private
# interface; do not expose the Hermes port publicly and do not enable CORS on it.
# HERMES_CAREER_OPS_BASE_URL="http://127.0.0.1:8642/p/career-ops"
# The career-ops profile's own API_SERVER_KEY. Give this profile a key that is
# not shared with any other profile.
# HERMES_CAREER_OPS_API_KEY="replace-with-the-career-ops-profile-api-key"
# REQUIRED. The Nexus user id whose API token the Hermes profile uses for the
# Nexus MCP server. The MCP server scopes every tool call to that token's owner,
# so an agent run always acts as this user no matter who started it — Career Ops
# is therefore available to this user only. Without this the feature stays off.
# Find it with: SELECT id FROM "User" WHERE email = 'you@example.com';
# HERMES_CAREER_OPS_OWNER_USER_ID="the-nexus-user-id-owning-the-mcp-token"
# Optional. Keys the opaque long-term-memory scope sent to Hermes. Defaults to
# HERMES_CAREER_OPS_API_KEY; set it explicitly if you rotate the API key and
# want conversations to keep their memory scope. Generate with:
#   openssl rand -hex 32
# HERMES_CAREER_OPS_SCOPE_SECRET="replace-with-64-hex-characters"
# Optional bounded timeouts in milliseconds (values below 1000 are ignored,
# values above 1800000 are clamped).
# HERMES_CAREER_OPS_CONNECT_TIMEOUT_MS="10000"
# HERMES_CAREER_OPS_STREAM_IDLE_TIMEOUT_MS="90000"
# HERMES_CAREER_OPS_RUN_TIMEOUT_MS="600000"
